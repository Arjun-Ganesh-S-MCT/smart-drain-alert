{
  "name": "flowbeacon",
  "version": "1.4.0",
  "description": "FlowBeacon by TechMinds: desktop monitor for the Smart Drainage Alert and Blockage Prediction System (ESP32-S3)",
  "main": "main.js",
  "author": {
    "name": "Smart Drainage Alert team",
    "email": "team@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Arjun-Ganesh-S-MCT/smart-drain-alert",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.js",
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --test tests/core.test.js tests/drip.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "leaflet": "^1.9.4"
  },
  "build": {
    "appId": "com.techminds.flowbeacon",
    "productName": "FlowBeacon",
    "copyright": "Copyright (c) 2026 TechMinds",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/*.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FlowBeacon-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FlowBeacon-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "FlowBeacon-${version}-linux.${ext}",
      "executableName": "flowbeacon"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Arjun-Ganesh-S-MCT",
        "repo": "smart-drain-alert"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arjun-Ganesh-S-MCT/smart-drain-alert.git"
  }
}
